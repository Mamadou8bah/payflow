# Copy to .env and fill in production values before `docker compose -f docker-compose.prod.yml up`.

POSTGRES_DB=sutura
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password

REDIS_PASSWORD=change-me-strong-redis-password

# Base64-encoded secret, at least 32 bytes when decoded.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Sentinel tenant integration credentials (Sentinel runs separately)
SUTURA_SENTINEL_BASE_URL=http://host.docker.internal:8080
SUTURA_SENTINEL_API_KEY=

# ModemPay
MODEMPAY_WEBHOOK_SIGNING_SECRET=
MODEMPAY_API_KEY=
MODEMPAY_PUBLIC_KEY=
MODEMPAY_API_URL=https://api.modempay.com

# Optional notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SUTURA_EMAIL_API_KEY=

# First-time schema bootstrap only (then switch back to validate)
# SPRING_JPA_DDL_AUTO=update

# Must match the Sentinel tenant webhook settings (at least 32 characters)
SUTURA_SENTINEL_WEBHOOK_SECRET=
SUTURA_SENTINEL_TENANT_CODE=
